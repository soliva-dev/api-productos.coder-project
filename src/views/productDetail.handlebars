<style>
    body {
        font-family: "Segoe UI", Arial, sans-serif;
        background-color: #f4f6fa;
        color: #333;
        margin: 0;
        padding: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .container {
        max-width: 800px;
        width: 100%;
    }
    .product-detail {
        background: white;
        border-radius: 10px;
        padding: 30px;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }
    .product-header {
        border-bottom: 1px solid #eee;
        padding-bottom: 20px;
        margin-bottom: 20px;
    }
    .product-title {
        color: #1f3a6f;
        margin: 0 0 10px 0;
        font-size: 2rem;
    }
    .product-id {
        color: #666;
        font-size: 0.9rem;
    }
    .product-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }
    .product-field {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 5px;
        border-left: 4px solid #007bff;
    }
    .field-label {
        font-weight: bold;
        color: #555;
        font-size: 0.9rem;
        margin-bottom: 5px;
    }
    .field-value {
        font-size: 1.1rem;
        color: #333;
    }
    .price {
        font-size: 1.5rem;
        color: #28a745;
        font-weight: bold;
    }
    .stock {
        color: #17a2b8;
        font-weight: bold;
    }
    .description {
        grid-column: 1 / -1;
        background: #fff;
        border: 1px solid #eee;
        padding: 20px;
        border-radius: 5px;
    }
    .actions {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }
    .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        font-size: 16px;
        font-weight: 500;
        transition: all 0.3s;
    }
    .btn-primary {
        background-color: #007bff;
        color: white;
    }
    .btn-primary:hover {
        background-color: #0056b3;
        transform: translateY(-1px);
    }
    .btn-success {
        background-color: #28a745;
        color: white;
    }
    .btn-success:hover {
        background-color: #1e7e34;
        transform: translateY(-1px);
    }
    .btn-secondary {
        background-color: #6c757d;
        color: white;
    }
    .btn-secondary:hover {
        background-color: #545b62;
        transform: translateY(-1px);
    }
    .status {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 15px;
        font-size: 0.9rem;
        font-weight: 500;
    }
    .status.active {
        background-color: #d4edda;
        color: #155724;
    }
    .status.inactive {
        background-color: #f8d7da;
        color: #721c24;
    }
    .thumbnails {
        grid-column: 1 / -1;
        margin-top: 20px;
    }
    .thumbnails-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
        gap: 10px;
        margin-top: 10px;
    }
    .thumbnail {
        aspect-ratio: 1;
        background: #f8f9fa;
        border: 1px dashed #ccc;
        border-radius: 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        color: #666;
    }
</style>

<div class="container">
    <div class="product-detail">
        <div class="product-header">
            <h1 class="product-title">{{product.title}}</h1>
            <div class="product-id">ID: {{product._id}}</div>
        </div>

        <div class="product-grid">
            <div class="product-field">
                <div class="field-label">Precio</div>
                <div class="field-value price">${{product.price}}</div>
            </div>

            <div class="product-field">
                <div class="field-label">Stock disponible</div>
                <div class="field-value stock">{{product.stock}} unidades</div>
            </div>

            <div class="product-field">
                <div class="field-label">Codigo</div>
                <div class="field-value">{{product.code}}</div>
            </div>

            <div class="product-field">
                <div class="field-label">Categoria</div>
                <div class="field-value">{{product.category}}</div>
            </div>

            <div class="product-field">
                <div class="field-label">Estado</div>
                <div class="field-value">
                    <span class="status {{#if product.status}}active{{else}}inactive{{/if}}">
                        {{#if product.status}}Activo{{else}}Inactivo{{/if}}
                    </span>
                </div>
            </div>

            <div class="product-field">
                <div class="field-label">Fecha de creacion</div>
                <div class="field-value">{{formatDate product.createdAt}}</div>
            </div>

            <div class="description">
                <div class="field-label">Descripcion</div>
                <div class="field-value">{{product.description}}</div>
            </div>

            {{#if product.thumbnails.length}}
            <div class="thumbnails">
                <div class="field-label">Imagenes</div>
                <div class="thumbnails-grid">
                    {{#each product.thumbnails}}
                        <div class="thumbnail">{{this}}</div>
                    {{/each}}
                </div>
            </div>
            {{/if}}
        </div>

        <div class="actions">
            <button onclick="addToCart('{{product._id}}')" class="btn btn-success">
                Agregar al Carrito
            </button>
            <a href="/products" class="btn btn-secondary">
                ← Volver al Catalogo
            </a>
        </div>
    </div>
</div>

<script>
async function addToCart(productId) {
    try {
        let cartId = localStorage.getItem('cartId');
        
        if (!cartId) {
            // Crear nuevo carrito
            const createCartResponse = await fetch('/api/carts', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });
            const cartData = await createCartResponse.json();
            cartId = cartData.payload._id;
            localStorage.setItem('cartId', cartId);
        }

        // Agregar producto al carrito
        const response = await fetch(`/api/carts/${cartId}/product/${productId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ quantity: 1 })
        });

        const result = await response.json();

        if (result.status === 'success') {
            alert('Producto agregado al carrito exitosamente');
            
            // Mostrar opcion para ir al carrito
            if (confirm('¿Quieres ir al carrito para ver tus productos?')) {
                window.location.href = `/carts/${cartId}`;
            }
        } else {
            alert('Error: ' + result.message);
        }
    } catch (error) {
        console.error('Error adding to cart:', error);
        alert('Error al agregar el producto al carrito');
    }
}
</script>