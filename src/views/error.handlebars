<style>
    body {
        font-family: "Segoe UI", Arial, sans-serif;
        background-color: #f4f6fa;
        color: #333;
        margin: 0;
        padding: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
    }
    .error-container {
        background: white;
        border-radius: 10px;
        padding: 40px;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
        text-align: center;
        max-width: 500px;
        width: 100%;
    }
    .error-icon {
        font-size: 4rem;
        margin-bottom: 20px;
    }
    .error-title {
        color: #dc3545;
        margin: 0 0 15px 0;
        font-size: 2rem;
    }
    .error-message {
        color: #666;
        margin: 0 0 10px 0;
        font-size: 1.1rem;
    }
    .error-details {
        background: #f8f9fa;
        border-left: 4px solid #dc3545;
        padding: 15px;
        margin: 20px 0;
        text-align: left;
        border-radius: 4px;
    }
    .error-code {
        font-family: monospace;
        color: #721c24;
        font-size: 0.9rem;
        word-break: break-word;
    }
    .btn {
        padding: 12px 24px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        font-size: 16px;
        font-weight: 500;
        margin: 10px;
        transition: all 0.3s;
    }
    .btn-primary {
        background-color: #007bff;
        color: white;
    }
    .btn-primary:hover {
        background-color: #0056b3;
    }
    .btn-secondary {
        background-color: #6c757d;
        color: white;
    }
    .btn-secondary:hover {
        background-color: #545b62;
    }
</style>

<div class="error-container">
    <div class="error-icon">⚠️</div>
    <h1 class="error-title">¡Oops! Algo salio mal</h1>
    <p class="error-message">{{message}}</p>
    
    {{#if error}}
    <div class="error-details">
        <strong>Detalles del error:</strong>
        <div class="error-code">{{error}}</div>
    </div>
    {{/if}}
    
    <div class="actions">
        <a href="/products" class="btn btn-primary">
            🏠 Ir al Inicio
        </a>
        <button onclick="history.back()" class="btn btn-secondary">
            ← Volver
        </button>
    </div>
</div>