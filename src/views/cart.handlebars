<style>
    body {
        font-family: "Segoe UI", Arial, sans-serif;
        background-color: #f4f6fa;
        color: #333;
        margin: 0;
        padding: 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .container {
        max-width: 1000px;
        width: 100%;
    }
    .cart-header {
        background: white;
        padding: 30px;
        border-radius: 10px;
        margin-bottom: 20px;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
        text-align: center;
    }
    .cart-title {
        color: #1f3a6f;
        margin: 0 0 10px 0;
        font-size: 2rem;
    }
    .cart-id {
        color: #666;
        font-size: 0.9rem;
    }
    .cart-summary {
        background: white;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
    }
    .summary-item {
        text-align: center;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
    }
    .summary-label {
        font-size: 0.9rem;
        color: #666;
        margin-bottom: 5px;
    }
    .summary-value {
        font-size: 1.5rem;
        font-weight: bold;
        color: #1f3a6f;
    }
    .total-value {
        color: #28a745;
    }
    .products-container {
        background: white;
        border-radius: 10px;
        padding: 0;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }
    .products-header {
        background: #f8f9fa;
        padding: 20px 30px;
        border-bottom: 1px solid #eee;
    }
    .products-title {
        margin: 0;
        color: #333;
        font-size: 1.3rem;
    }
    .product-item {
        border-bottom: 1px solid #f0f0f0;
        padding: 20px 30px;
        display: grid;
        grid-template-columns: 1fr 120px 80px 80px 120px;
        gap: 20px;
        align-items: center;
        transition: background-color 0.3s;
    }
    .product-item:hover {
        background-color: #f9f9f9;
    }
    .product-item:last-child {
        border-bottom: none;
    }
    .product-info {
        min-width: 0;
    }
    .product-name {
        font-weight: bold;
        color: #1f3a6f;
        margin: 0 0 5px 0;
        font-size: 1.1rem;
    }
    .product-desc {
        color: #666;
        font-size: 0.9rem;
        margin: 0 0 5px 0;
    }
    .product-id {
        color: #999;
        font-size: 0.8rem;
    }
    .product-price {
        text-align: center;
        font-weight: bold;
        color: #28a745;
        font-size: 1.1rem;
    }
    .product-quantity {
        text-align: center;
    }
    .quantity-control {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }
    .quantity-btn {
        width: 24px;
        height: 24px;
        border: 1px solid #ccc;
        background: white;
        border-radius: 4px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        transition: all 0.2s;
    }
    .quantity-btn:hover {
        background: #f0f0f0;
        border-color: #999;
    }
    .quantity-display {
        min-width: 30px;
        text-align: center;
        font-weight: bold;
    }
    .product-total {
        text-align: center;
        font-weight: bold;
        color: #333;
        font-size: 1.1rem;
    }
    .product-actions {
        text-align: center;
    }
    .btn {
        padding: 6px 12px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        font-size: 14px;
        transition: all 0.3s;
    }
    .btn-danger {
        background-color: #dc3545;
        color: white;
    }
    .btn-danger:hover {
        background-color: #c82333;
    }
    .btn-primary {
        background-color: #007bff;
        color: white;
        padding: 12px 24px;
        font-size: 16px;
    }
    .btn-primary:hover {
        background-color: #0056b3;
    }
    .btn-secondary {
        background-color: #6c757d;
        color: white;
        padding: 12px 24px;
        font-size: 16px;
    }
    .btn-secondary:hover {
        background-color: #545b62;
    }
    .cart-actions {
        margin-top: 20px;
        display: flex;
        gap: 15px;
        justify-content: center;
    }
    .empty-cart {
        text-align: center;
        padding: 60px 30px;
        color: #666;
    }
    .empty-cart h3 {
        color: #999;
        margin-bottom: 10px;
    }
    @media (max-width: 768px) {
        .product-item {
            grid-template-columns: 1fr;
            gap: 10px;
        }
        .cart-summary {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container">
    <div class="cart-header">
        <h1 class="cart-title">Mi Carrito</h1>
        <div class="cart-id">ID del carrito: {{cart._id}}</div>
    </div>

    {{#if hasProducts}}
        <div class="cart-summary">
            <div class="summary-item">
                <div class="summary-label">Total de productos</div>
                <div class="summary-value">{{totalItems}}</div>
            </div>
            <div class="summary-item">
                <div class="summary-label">Total a pagar</div>
                <div class="summary-value total-value">${{totalAmount}}</div>
            </div>
        </div>

        <div class="products-container">
            <div class="products-header">
                <h2 class="products-title">Productos en el carrito</h2>
            </div>
            
            {{#each products}}
            <div class="product-item" id="cart-item-{{this.product._id}}">
                <div class="product-info">
                    <h3 class="product-name">{{this.product.title}}</h3>
                    <p class="product-desc">{{this.product.description}}</p>
                    <div class="product-id">ID: {{this.product._id}} | Categoria: {{this.product.category}}</div>
                </div>
                <div class="product-price">
                    ${{this.product.price}}
                </div>
                <div class="product-quantity">
                    <div class="quantity-control">
                        <button class="quantity-btn" onclick="updateQuantity('{{../cart._id}}', '{{this.product._id}}', {{this.quantity}} - 1)">-</button>
                        <span class="quantity-display">{{this.quantity}}</span>
                        <button class="quantity-btn" onclick="updateQuantity('{{../cart._id}}', '{{this.product._id}}', {{this.quantity}} + 1)">+</button>
                    </div>
                </div>
                <div class="product-total">
                    ${{#multiply this.product.price this.quantity}}{{/multiply}}
                </div>
                <div class="product-actions">
                    <button class="btn btn-danger" onclick="removeFromCart('{{../cart._id}}', '{{this.product._id}}')">
                        Eliminar
                    </button>
                </div>
            </div>
            {{/each}}
        </div>

        <div class="cart-actions">
            <button class="btn btn-primary" onclick="proceedToCheckout()">
                Procesar Pago
            </button>
            <button class="btn btn-danger" onclick="clearCart('{{cart._id}}')">
                Vaciar Carrito
            </button>
            <a href="/products" class="btn btn-secondary">
                ← Seguir Comprando
            </a>
        </div>
    {{else}}
        <div class="products-container">
            <div class="empty-cart">
                <h3>Tu carrito esta vacio</h3>
                <p>¡Agrega algunos productos para comenzar!</p>
                <a href="/products" class="btn btn-primary">
                    Explorar Productos
                </a>
            </div>
        </div>
    {{/if}}
</div>

<script>
async function updateQuantity(cartId, productId, newQuantity) {
    if (newQuantity <= 0) {
        removeFromCart(cartId, productId);
        return;
    }

    try {
        const response = await fetch(`/api/carts/${cartId}/products/${productId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ quantity: newQuantity })
        });

        const result = await response.json();

        if (result.status === 'success') {
            // Recargar la pagina para mostrar cambios
            window.location.reload();
        } else {
            alert('Error: ' + result.message);
        }
    } catch (error) {
        console.error('Error updating quantity:', error);
        alert('Error al actualizar la cantidad');
    }
}

async function removeFromCart(cartId, productId) {
    if (!confirm('¿Estas seguro de que quieres eliminar este producto del carrito?')) {
        return;
    }

    try {
        const response = await fetch(`/api/carts/${cartId}/products/${productId}`, {
            method: 'DELETE'
        });

        const result = await response.json();

        if (result.status === 'success') {
            // Recargar la pagina para mostrar cambios
            window.location.reload();
        } else {
            alert('Error: ' + result.message);
        }
    } catch (error) {
        console.error('Error removing from cart:', error);
        alert('Error al eliminar el producto del carrito');
    }
}

async function clearCart(cartId) {
    if (!confirm('¿Estas seguro de que quieres vaciar todo el carrito?')) {
        return;
    }

    try {
        const response = await fetch(`/api/carts/${cartId}`, {
            method: 'DELETE'
        });

        const result = await response.json();

        if (result.status === 'success') {
            // Recargar la pagina para mostrar cambios
            window.location.reload();
        } else {
            alert('Error: ' + result.message);
        }
    } catch (error) {
        console.error('Error clearing cart:', error);
        alert('Error al vaciar el carrito');
    }
}

function proceedToCheckout() {
    alert('Funcionalidad de pago no implementada en este demo.\n\n¡Gracias por usar nuestro carrito de compras!');
}
</script>